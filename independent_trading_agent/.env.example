# Independent Trading Agent: environment settings.
# Copy to independent_trading_agent/.env and fill in. Every variable carries the
# INDEPENDENT_AGENT_ prefix, so nothing here collides with TradingAgents' own .env.
# Never commit the real .env (it is git-ignored).

# ---- Markets (priority order is fixed: forex, nasdaq, nyse, crypto, tsx, tsxv) ----
#INDEPENDENT_AGENT_MARKETS=forex,nasdaq,nyse,crypto,tsx
#INDEPENDENT_AGENT_UNIVERSE_FOREX=EURUSD,GBPUSD,USDJPY,AUDUSD,USDCAD,USDCHF,NZDUSD,XAUUSD
#INDEPENDENT_AGENT_UNIVERSE_NASDAQ=AAPL,MSFT,NVDA,AMZN,GOOGL,META,AVGO,TSLA,AMD,NFLX,COST,ADBE,QQQ
#INDEPENDENT_AGENT_UNIVERSE_TSXV=          # empty by default: add symbols such as XYZ.V yourself
#INDEPENDENT_AGENT_WATCHLIST=EURUSD,XAUUSD   # always analysed in the daily run (mode 1)

# ---- Scan limits ----
#INDEPENDENT_AGENT_MAX_SYMBOLS_PER_MARKET=15
#INDEPENDENT_AGENT_MAX_TOTAL_SYMBOLS=60
#INDEPENDENT_AGENT_TOP_N=5
#INDEPENDENT_AGENT_DEEP_TOP_K=3
#INDEPENDENT_AGENT_MAX_DATA_REQUESTS=40
#INDEPENDENT_AGENT_REQUEST_DELAY_SECONDS=0.5

# ---- Timing ----
#INDEPENDENT_AGENT_TIMEFRAME=1d
#INDEPENDENT_AGENT_HORIZON_BARS=10
#INDEPENDENT_AGENT_REPORT_TIMEZONE=America/Toronto
#INDEPENDENT_AGENT_RUN_TIME=18:30

# ---- Hypothetical portfolio and risk (no real orders, ever) ----
#INDEPENDENT_AGENT_ACCOUNT_CURRENCY=USD
#INDEPENDENT_AGENT_PORTFOLIO_VALUE=100000
#INDEPENDENT_AGENT_RISK_PER_TRADE_PCT=1.0
#INDEPENDENT_AGENT_MIN_REWARD_RISK=1.5

# ---- LLM for the sentiment reading of TradingAgents' news report (one call per analysed symbol) ----
#INDEPENDENT_AGENT_LLM_ENABLED=true
#INDEPENDENT_AGENT_LLM_CHAIN=gemini:gemini-3.5-flash-lite,gemini:gemini-3.5-flash,openrouter:nvidia/nemotron-3-ultra-550b-a55b:free
#INDEPENDENT_AGENT_MAX_LLM_CALLS=10
#INDEPENDENT_AGENT_GEMINI_API_KEY=
#INDEPENDENT_AGENT_OPENROUTER_API_KEY=
#INDEPENDENT_AGENT_OPENAI_API_KEY=

# ---- Optional macro data for forex (free key: https://fred.stlouisfed.org/docs/api/api_key.html) ----
#INDEPENDENT_AGENT_FRED_API_KEY=

# ---- TradingAgents: the analysis engine (uses TradingAgents' own .env keys and model chain) ----
#INDEPENDENT_AGENT_TRADINGAGENTS_ENABLED=true
#INDEPENDENT_AGENT_TRADINGAGENTS_MAX_RUNS=4              # each run makes dozens of LLM calls
#INDEPENDENT_AGENT_TRADINGAGENTS_ANALYSTS=market,news     # forex, gold, crypto
#INDEPENDENT_AGENT_TRADINGAGENTS_ANALYSTS_STOCK=market,news,fundamentals
#INDEPENDENT_AGENT_TRADINGAGENTS_LANGUAGE=Persian
#INDEPENDENT_AGENT_TRADINGAGENTS_TIMEOUT_SECONDS=900

# ---- Output ----
#INDEPENDENT_AGENT_PDF_ENABLED=true
#INDEPENDENT_AGENT_DASHBOARD_PORT=8765
